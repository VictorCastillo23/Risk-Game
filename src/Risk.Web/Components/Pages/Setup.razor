@page "/"
@using Risk.Domain.Errors
@using Risk.Engine.Events
@using Risk.Engine.Results
@using Risk.Engine.Setup
@using Risk.Engine.State
@using Risk.Web.Components.Shared
@using Risk.Web.Models
@using Risk.Web.Services
@inject GameSessionService Session
@inject NetworkGameRegistry Games
@inject NetworkedSeatContext NetContext
@inject NavigationManager Navigation

<PageTitle>Risk — Configurar partida</PageTitle>

<div class="setup-header">
    <h1>Configurar partida</h1>
    <button type="button" @onclick="@(() => Navigation.NavigateTo("/saved"))">Ver partida guardada</button>
</div>

<div class="setup-variant">
    <label>
        <input type="radio" name="game-variant" checked="@(_variant == "local")" @onchange="@(() => _variant = "local")" />
        Local (hot-seat)
    </label>
    <label>
        <input type="radio" name="game-variant" checked="@(_variant == "red")" @onchange="@(() => _variant = "red")" />
        En red (multidispositivo)
    </label>
</div>

<div class="setup-game-mode">
    <label for="game-mode">Modo de juego</label>
    <select id="game-mode" @onchange="OnModeChanged">
        @foreach (var mode in SelectableModes)
        {
            <option value="@mode" selected="@(mode == _mode)">@GameModeDisplay.Label(mode)</option>
        }
    </select>
</div>

@if (_variant == "local")
{
<div class="setup-player-count">
    <label for="player-count">Cantidad de jugadores</label>
    <select id="player-count" @onchange="OnPlayerCountChanged">
        @for (var count = MinPlayers; count <= MaxPlayers; count++)
        {
            <option value="@count" selected="@(count == _rows.Count)">@count</option>
        }
    </select>
</div>

@for (var i = 0; i < _rows.Count; i++)
{
    var index = i;
    var row = _rows[index];
    var selectedColors = _rows.Select(r => (string?)r.ColorHex).ToArray();

    <div class="setup-row">
        <input type="text"
               value="@row.Name"
               placeholder="Jugador @(index + 1)"
               @oninput="e => OnNameChanged(index, (string?)e.Value)" />

        <div class="setup-swatches" role="group" aria-label="@($"Color jugador {index + 1}")">
            @foreach (var swatch in PlayerPalette.Swatches)
            {
                var available = PlayerPalette.IsAvailable(swatch, index, selectedColors);
                var selected = row.ColorHex == swatch;

                <button type="button"
                        class="setup-swatch @(selected ? "selected" : "")"
                        style="background-color:@swatch"
                        disabled="@(!available)"
                        aria-pressed="@selected"
                        @onclick="() => OnColorSelected(index, swatch)">
                </button>
            }
        </div>

        <div class="setup-ai-toggle">
            <label>
                <input type="radio" name="@($"ai-toggle-{index}")" checked="@(!row.IsAi)" @onchange="() => OnAiToggled(index, false)" />
                Humano
            </label>
            <label>
                <input type="radio" name="@($"ai-toggle-{index}")" checked="@row.IsAi" @onchange="() => OnAiToggled(index, true)" />
                IA
            </label>
        </div>
    </div>
}

<button type="button" @onclick="OnStart">Comenzar partida</button>
}
else
{
<div class="setup-networked">
    <p>Crea una partida en red: obtendrás un código para que otros se unan desde sus dispositivos.</p>
    <input type="text"
           value="@_netName"
           placeholder="Tu nombre (anfitrión)"
           @oninput="e => _netName = (string?)e.Value ?? string.Empty" />

    <div class="setup-swatches" role="group" aria-label="Tu color">
        @foreach (var swatch in PlayerPalette.Swatches)
        {
            <button type="button"
                    class="setup-swatch @(_netColor == swatch ? "selected" : "")"
                    style="background-color:@swatch"
                    aria-pressed="@(_netColor == swatch)"
                    @onclick="() => _netColor = swatch">
            </button>
        }
    </div>

    <button type="button" @onclick="OnCreateNetworked">Crear partida en red</button>
    <p>O <a href="/join">unirse a una partida</a> con un código.</p>
</div>
}

<RejectionMessage Error="_error" />

@code {
    // Classic, SecretMission, TwoPlayer, and Capital (the last mode) are
    // offered today.
    // The <select> element stays present and array-driven so a future item
    // can add more modes without restructuring this markup.
    private static readonly GameMode[] SelectableModes = [GameMode.Classic, GameMode.SecretMission, GameMode.TwoPlayer, GameMode.Capital];

    private GameMode _mode = GameMode.Classic;

    private int MinPlayers => GameSetup.PlayerCountRange(_mode).Min;
    private int MaxPlayers => GameSetup.PlayerCountRange(_mode).Max;

    private List<PlayerSetupRow> _rows = BuildRows(GameSetup.PlayerCountRange(GameMode.Classic).Min);
    private GameError? _error;

    // Networked variant (openspec risk-web-multiplayer): "local" keeps the
    // hot-seat flow above byte-identical; "red" collects just the host's
    // identity and creates the game (lobby + joiners live in Lobby/Join).
    private string _variant = "local";
    private string _netName = string.Empty;
    private string _netColor = PlayerPalette.Swatches[0];

    private static List<PlayerSetupRow> BuildRows(int count) =>
        Enumerable.Range(0, count)
            .Select(i => new PlayerSetupRow($"Jugador {i + 1}", PlayerPalette.Swatches[i], false))
            .ToList();

    private void OnModeChanged(ChangeEventArgs e)
    {
        _mode = Enum.Parse<GameMode>((string)e.Value!);

        if (_rows.Count < MinPlayers || _rows.Count > MaxPlayers)
        {
            _rows = BuildRows(Math.Clamp(_rows.Count, MinPlayers, MaxPlayers));
        }

        _error = null;
    }

    private void OnPlayerCountChanged(ChangeEventArgs e)
    {
        var count = int.Parse((string)e.Value!);
        _rows = BuildRows(count);
        _error = null;
    }

    private void OnNameChanged(int index, string? name)
    {
        _rows[index] = _rows[index] with { Name = name ?? string.Empty };
    }

    private void OnColorSelected(int index, string swatch)
    {
        var selectedColors = _rows.Select(r => (string?)r.ColorHex).ToArray();
        if (!PlayerPalette.IsAvailable(swatch, index, selectedColors))
        {
            return;
        }

        _rows[index] = _rows[index] with { ColorHex = swatch };
    }

    private void OnAiToggled(int index, bool isAi)
    {
        _rows[index] = _rows[index] with { IsAi = isAi };
    }

    private void OnStart()
    {
        var result = Session.Start(_rows, _mode);

        switch (result)
        {
            case CommandResult<GameState, GameEvent>.Ok:
                _error = null;
                Navigation.NavigateTo("/game");
                break;
            case CommandResult<GameState, GameEvent>.Rejected rejected:
                _error = rejected.Error;
                break;
        }
    }

    /// <summary>
    /// Networked creation: empty session + host seat bound to this circuit,
    /// then hand off to the lobby. Mode travels with the host circuit into
    /// Lobby (component field there) — nothing is started yet, so joiners
    /// can still arrive before the first turn exists.
    /// </summary>
    private void OnCreateNetworked()
    {
        var name = string.IsNullOrWhiteSpace(_netName) ? "Anfitrión" : _netName.Trim();
        var session = Games.Create();
        var seat = session.ClaimSeat(name, _netColor, NetContext.CircuitId);
        NetContext.Code = session.Code;
        NetContext.Seat = seat;
        _error = null;
        Navigation.NavigateTo($"/lobby/{session.Code.Value}");
    }
}
