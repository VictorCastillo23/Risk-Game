@page "/game"
@implements IDisposable
@using Risk.Domain.Map
@using Risk.Engine.Events
@using Risk.Engine.State
@using Risk.Web.Components.Game
@using Risk.Web.Models
@using Risk.Web.Services
@inject GameSessionService Session
@inject NavigationManager Navigation

<PageTitle>Risk — Partida</PageTitle>

@if (Session.IsStarted)
{
    var state = Session.State!;
    var pendingOccupation = state.Turn.PendingOccupation;
    // Once GameStatus.Won, GameEngine.Execute rejects *every* command
    // (including OccupyCommand — see the first check in GameEngine.Execute),
    // so a lingering PendingOccupation from the winning attack can never be
    // resolved. VictoryScreen must therefore take priority over the
    // occupation gate below, or OccupyPrompt would render a "Confirmar"
    // button that always fails with GameOver.
    var isWon = state.Status is GameStatus.Won;

    <PhaseIndicator State="state" Players="Session.Players" />
    <BoardSvg State="state" Players="Session.Players" Selected="_selection.Origin" OnTerritoryClick="OnTerritoryClick" OnTerritoryRightClick="OnTerritoryRightClick" Pending="_staging.Pending" Locked="isWon || pendingOccupation is not null" />
    <DicePanel Battle="_lastBattle" />
    <CardPanel CurrentPlayer="state.Turn.CurrentPlayer" Locked="isWon || pendingOccupation is not null" />
    <LogPanel Log="state.Log" />

    @if (state.Status is GameStatus.Won won)
    {
        <VictoryScreen Winner="Session.ConfigFor(won.Winner)" />
    }
    else if (pendingOccupation is not null)
    {
        <OccupyPrompt CurrentPlayer="state.Turn.CurrentPlayer" Pending="pendingOccupation" SourceTerritoryTroops="state.Territories[pendingOccupation.From].Troops" />
    }
    else if (state.Turn.Phase == TurnPhase.Setup)
    {
        <SetupPanel CurrentPlayer="state.Turn.CurrentPlayer" SelectedTerritory="_selection.Origin" />
    }
    else if (state.Turn.Phase == TurnPhase.Reinforce)
    {
        <ReinforcePanel CurrentPlayer="state.Turn.CurrentPlayer" State="state" Staging="_staging" OnStagingChanged="staging => _staging = staging" />
    }
    else if (state.Turn.Phase == TurnPhase.Attack)
    {
        <AttackPanel CurrentPlayer="state.Turn.CurrentPlayer" State="state" Origin="_selection.Origin" Destination="_selection.Destination" />
    }
    else if (state.Turn.Phase == TurnPhase.Fortify)
    {
        <FortifyPanel CurrentPlayer="state.Turn.CurrentPlayer" State="state" Origin="_selection.Origin" Destination="_selection.Destination" />
    }
}

@code {
    // Design's read convention (D5): board/turn/phase come straight off
    // Session.State (GameState), never Observe() — only the hand-of-cards
    // panel (a later PR) needs the redacted PlayerView seam.
    private BoardSelection _selection = BoardSelection.Empty;

    // Reinforce is staged client-side only (left-click stages +1, right-click
    // -1, "Confirmar" dispatches) — never routed through BoardSelection,
    // since PlaceTroopsCommand has no undo and this needs to preview several
    // territories at once before committing any of them.
    private TroopStaging _staging = TroopStaging.Empty;

    // Session.LastEvents only ever holds the delta from the most recent Ok
    // (design's own contract), so a non-attack command (e.g. Fortify,
    // EndPhase) would otherwise make the last battle's result vanish from
    // LastEvents even though it's still the most recent battle that
    // happened. Tracked locally here so DicePanel keeps showing it across
    // subsequent unrelated commands, updating only when a new
    // BattleResolved actually occurs.
    private BattleResolved? _lastBattle;

    protected override void OnInitialized()
    {
        if (!Session.IsStarted)
        {
            Navigation.NavigateTo("/");
            return;
        }

        Session.Changed += OnSessionChanged;
    }

    // Reinforce, Attack, and Fortify all react to board clicks. Fortify click
    // wiring (PR7) reuses BoardSelection.Click unchanged — it was already
    // phase-aware since PR4 (friendly-path BFS included) — it just needed to
    // stop being gated out here.
    //
    // While a PendingOccupation gate is active, all board clicks are ignored —
    // mirroring the engine's own OccupationPending rejection as a UX nicety
    // (the engine remains authoritative regardless of what the UI blocks).
    private static readonly TurnPhase[] ClickablePhases = [TurnPhase.Setup, TurnPhase.Reinforce, TurnPhase.Attack, TurnPhase.Fortify];

    private void OnTerritoryClick(TerritoryId territory)
    {
        var state = Session.State;

        if (state is null || state.Status is GameStatus.Won || state.Turn.PendingOccupation is not null || !ClickablePhases.Contains(state.Turn.Phase))
        {
            return;
        }

        if (state.Turn.Phase == TurnPhase.Reinforce)
        {
            if (state.Territories[territory].Owner != state.Turn.CurrentPlayer)
            {
                return;
            }

            var remainingPool = state.Players.Single(p => p.Id == state.Turn.CurrentPlayer).TroopsRemaining;
            _staging = _staging.Add(territory, remainingPool);
            return;
        }

        _selection = _selection.Click(territory, state, state.Turn.CurrentPlayer, state.Turn.Phase);
    }

    // Right-click only ever un-stages a Reinforce placement — every other
    // clickable phase has no staging concept, so it's a no-op there.
    private void OnTerritoryRightClick(TerritoryId territory)
    {
        var state = Session.State;

        if (state is null || state.Status is GameStatus.Won || state.Turn.PendingOccupation is not null || state.Turn.Phase != TurnPhase.Reinforce)
        {
            return;
        }

        _staging = _staging.Remove(territory);
    }

    // Any successful command re-renders from new state, so the previous
    // selection no longer applies — clearing it here (rather than per-panel)
    // keeps every future phase panel's dispatch code free of this concern.
    private void OnSessionChanged()
    {
        _selection = BoardSelection.Empty;

        // Staging is a multi-dispatch batch owned by ReinforcePanel's own
        // Confirmar loop (cleared/reduced there via OnStagingChanged) — NOT
        // reset on every single command success, since one successful
        // placement inside that loop must not wipe out other territories'
        // still-not-yet-dispatched staged troops. Only reset once the turn
        // actually leaves Reinforce, so stray un-confirmed clicks (the
        // player left-clicked a territory but ended the phase without
        // confirming) never leak a phantom "+N" badge into a later turn.
        if (Session.State?.Turn.Phase != TurnPhase.Reinforce)
        {
            _staging = TroopStaging.Empty;
        }

        _lastBattle = BattleEventSelector.MostRecent(Session.LastEvents) ?? _lastBattle;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
