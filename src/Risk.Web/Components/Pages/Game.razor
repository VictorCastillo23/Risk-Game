@page "/game"
@rendermode InteractiveServer
@implements IDisposable
@using Risk.Web.Components.Game
@using Risk.Web.Services
@inject GameSessionService Session
@inject NavigationManager Navigation

<PageTitle>Risk — Partida</PageTitle>

@if (Session.IsStarted)
{
    <PhaseIndicator State="Session.State!" Players="Session.Players" />
    <BoardSvg State="Session.State!" Players="Session.Players" />
}

@code {
    // Design's read convention (D5): board/turn/phase come straight off
    // Session.State (GameState), never Observe() — only the hand-of-cards
    // panel (a later PR) needs the redacted PlayerView seam.
    protected override void OnInitialized()
    {
        if (!Session.IsStarted)
        {
            Navigation.NavigateTo("/");
            return;
        }

        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
