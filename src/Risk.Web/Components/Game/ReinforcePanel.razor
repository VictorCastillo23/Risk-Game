@using Risk.Domain.Errors
@using Risk.Domain.Map
@using Risk.Domain.Players
@using Risk.Engine.Commands
@using Risk.Engine.Events
@using Risk.Engine.Results
@using Risk.Engine.State
@using Risk.Web.Components.Shared
@using Risk.Web.Services
@inject GameSessionService Session

<div class="reinforce-panel">
    @if (SelectedTerritory is null)
    {
        <p class="reinforce-panel-hint">Elegí un territorio propio para reforzar.</p>
    }
    else
    {
        <p class="reinforce-panel-hint">Territorio seleccionado: @SelectedTerritory.Value.Value</p>
    }

    <input type="number" min="1" value="@_troops" disabled="@(SelectedTerritory is null)" @oninput="OnTroopsChanged" />

    <button type="button" disabled="@(SelectedTerritory is null)" @onclick="OnPlaceClicked">Colocar</button>
    <button type="button" @onclick="OnEndPhaseClicked">Terminar refuerzo</button>

    <RejectionMessage Error="_error" />
</div>

@code {
    /// <summary>Always the acting player for this panel's commands (design's dispatch contract: <c>Actor = Turn.CurrentPlayer</c>).</summary>
    [Parameter, EditorRequired]
    public PlayerId CurrentPlayer { get; set; }

    /// <summary>The territory currently selected on the board, if any — owned by the host page's <c>BoardSelection</c>.</summary>
    [Parameter]
    public TerritoryId? SelectedTerritory { get; set; }

    private int _troops = 1;
    private GameError? _error;

    private void OnTroopsChanged(ChangeEventArgs e)
    {
        if (int.TryParse((string?)e.Value, out var troops) && troops > 0)
        {
            _troops = troops;
        }
    }

    private void OnPlaceClicked()
    {
        if (SelectedTerritory is null)
        {
            return;
        }

        Dispatch(new PlaceTroopsCommand(CurrentPlayer, SelectedTerritory.Value, _troops));
    }

    private void OnEndPhaseClicked() => Dispatch(new EndPhaseCommand(CurrentPlayer));

    /// <summary>
    /// Shared dispatch idiom (design's command-dispatch contract): call
    /// <see cref="GameSessionService.Execute"/>, pattern-match the result —
    /// <c>Ok</c> clears the inline error (the board/session re-renders via
    /// <c>Session.Changed</c>), <c>Rejected</c> renders it inline without
    /// altering displayed state.
    /// </summary>
    private void Dispatch(GameCommand command)
    {
        var result = Session.Execute(command);

        _error = result switch
        {
            CommandResult<GameState, GameEvent>.Ok => null,
            CommandResult<GameState, GameEvent>.Rejected rejected => rejected.Error,
            _ => _error
        };
    }
}
