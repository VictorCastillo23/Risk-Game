@using Risk.Domain.Errors
@using Risk.Domain.Map
@using Risk.Domain.Players
@using Risk.Engine.Commands
@using Risk.Engine.Events
@using Risk.Engine.Results
@using Risk.Engine.State
@using Risk.Web.Components.Shared
@using Risk.Web.Models
@using Risk.Web.Services
@inject GameSessionService Session

<div class="reinforce-panel">
    @if (Staging.TotalStaged == 0)
    {
        <p class="reinforce-panel-hint">Click izquierdo en un país propio para sumarle una tropa; click derecho para sacarla. Tropas por colocar: @RemainingPool</p>
    }
    else
    {
        <p class="reinforce-panel-hint">Tropas por colocar: @RemainingPool</p>
        <ul class="reinforce-panel-staged">
            @foreach (var (territory, count) in Staging.Pending)
            {
                <li>@territory.Value: +@count</li>
            }
        </ul>
    }

    <button type="button" disabled="@(Staging.TotalStaged == 0)" @onclick="OnConfirmClicked">Confirmar</button>
    <button type="button" @onclick="OnEndPhaseClicked">Terminar refuerzo</button>

    <RejectionMessage Error="_error" />
</div>

@code {
    /// <summary>Always the acting player for this panel's commands (design's dispatch contract: <c>Actor = Turn.CurrentPlayer</c>).</summary>
    [Parameter, EditorRequired]
    public PlayerId CurrentPlayer { get; set; }

    /// <summary>The state to read the live troop pool from (design D5: read straight off <c>GameState</c>).</summary>
    [Parameter, EditorRequired]
    public GameState State { get; set; } = null!;

    /// <summary>Client-side-only staged placements — owned by the host page, mutated there via board left/right clicks.</summary>
    [Parameter, EditorRequired]
    public TroopStaging Staging { get; set; } = null!;

    /// <summary>Raised after a Confirmar attempt with the remaining (possibly reduced) staging — the host page owns the field this updates.</summary>
    [Parameter]
    public EventCallback<TroopStaging> OnStagingChanged { get; set; }

    private GameError? _error;

    /// <summary>The engine's live pool minus whatever's already staged locally but not yet dispatched.</summary>
    private int RemainingPool => State.Players.Single(p => p.Id == CurrentPlayer).TroopsRemaining - Staging.TotalStaged;

    /// <summary>
    /// Dispatches one <see cref="PlaceTroopsCommand"/> per staged territory.
    /// Stops at the first rejection (leaving it and everything after it
    /// staged, since they were never actually placed) — only territories
    /// that dispatched successfully are dropped from what's reported back.
    /// </summary>
    private async Task OnConfirmClicked()
    {
        var remaining = new Dictionary<TerritoryId, int>(Staging.Pending);

        foreach (var (territory, count) in Staging.Pending)
        {
            var result = Session.Execute(new PlaceTroopsCommand(CurrentPlayer, territory, count));

            if (result is CommandResult<GameState, GameEvent>.Rejected rejected)
            {
                _error = rejected.Error;
                await OnStagingChanged.InvokeAsync(new TroopStaging(remaining));
                return;
            }

            _error = null;
            remaining.Remove(territory);
        }

        await OnStagingChanged.InvokeAsync(new TroopStaging(remaining));
    }

    private void OnEndPhaseClicked() => Dispatch(new EndPhaseCommand(CurrentPlayer));

    /// <summary>
    /// Shared dispatch idiom (design's command-dispatch contract): call
    /// <see cref="GameSessionService.Execute"/>, pattern-match the result —
    /// <c>Ok</c> clears the inline error (the board/session re-renders via
    /// <c>Session.Changed</c>), <c>Rejected</c> renders it inline without
    /// altering displayed state.
    /// </summary>
    private void Dispatch(GameCommand command)
    {
        var result = Session.Execute(command);

        _error = result switch
        {
            CommandResult<GameState, GameEvent>.Ok => null,
            CommandResult<GameState, GameEvent>.Rejected rejected => rejected.Error,
            _ => _error
        };
    }
}
