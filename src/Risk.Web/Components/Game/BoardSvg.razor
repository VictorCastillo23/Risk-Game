@using Risk.Domain.Map
@using Risk.Domain.Players
@using Risk.Engine.State
@using Risk.Web.Models

<svg class="board-svg" style="@(Locked ? "pointer-events: none;" : null)" viewBox="0 0 @TerritoryLayout.CanvasWidth @TerritoryLayout.CanvasHeight" xmlns="http://www.w3.org/2000/svg">
    <g class="board-continents">
        @foreach (var continent in Continents.All)
        {
            var bounds = TerritoryLayout.ContinentBounds[continent.Id];
            var haloColor = ContinentPalette.ColorOf(continent.Id);

            <rect class="board-continent-halo" x="@bounds.X" y="@bounds.Y" width="@bounds.Width" height="@bounds.Height" rx="28" fill="@haloColor" stroke="@haloColor" />
            <g transform="translate(@(bounds.X + 14), @(bounds.Y + 24))">
                <text class="board-continent-label">@ContinentDisplay.Label(continent.Id)</text>
            </g>
        }
    </g>

    <g class="board-edges">
        @foreach (var edge in BoardEdges.UniqueEdges())
        {
            var from = TerritoryLayout.Coordinates[edge.A];
            var to = TerritoryLayout.Coordinates[edge.B];
            var isSeaRoute = BoardEdges.IsSeaRoute(edge.A, edge.B);

            <line class="board-edge @(isSeaRoute ? "board-edge-sea" : "")" x1="@from.X" y1="@from.Y" x2="@to.X" y2="@to.Y" />
        }
    </g>

    <g class="board-territories">
        @foreach (var (id, position) in TerritoryLayout.Coordinates)
        {
            var territory = State.Territories[id];
            var color = BoardColors.OwnerColor(territory.Owner, Players);
            var continentColor = ContinentPalette.ColorOf(TerritoryLayout.ContinentOf[id]);
            var isSelected = Selected == id;
            var pending = Pending?.GetValueOrDefault(id) ?? 0;

            <g class="board-territory @(isSelected ? "board-territory-selected" : "")"
               @onclick="() => OnTerritoryClick.InvokeAsync(id)"
               @oncontextmenu="() => OnTerritoryRightClick.InvokeAsync(id)" @oncontextmenu:preventDefault="true">
                <polygon class="board-territory-marker" points="@TerritoryLayout.PolygonPointsAttr[id]" fill="@color" stroke="@continentColor" />
                <g transform="translate(@position.X, @position.Y)">
                    <text class="board-territory-troops" text-anchor="middle" dy="4">@territory.Troops</text>
                    <text class="board-territory-pending" text-anchor="middle" dy="28" style="@(pending > 0 ? null : "display:none")">+@pending</text>
                </g>
            </g>
        }
    </g>
</svg>

@code {
    /// <summary>The state to render — territory ownership and troop counts (design D5: read straight off <c>GameState</c>).</summary>
    [Parameter, EditorRequired]
    public GameState State { get; set; } = null!;

    /// <summary>Owner-to-color/name lookup for the active session's players.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<PlayerId, PlayerConfig> Players { get; set; } = null!;

    /// <summary>The currently selected territory (if any) — highlighted with a CSS class; selection semantics live in <see cref="BoardSelection"/>, not here.</summary>
    [Parameter]
    public TerritoryId? Selected { get; set; }

    /// <summary>
    /// True while a <c>PendingOccupation</c> gate is active (design's
    /// PendingOccupation flow): the board becomes visually non-interactive
    /// via <c>pointer-events: none</c>. Purely a UX affordance — the host
    /// page's click handler already ignores clicks in this state, and the
    /// engine independently rejects everything else with <c>OccupationPending</c>.
    /// </summary>
    [Parameter]
    public bool Locked { get; set; }

    /// <summary>Raised with the clicked territory's id; the host page decides what a click means for the active phase.</summary>
    [Parameter]
    public EventCallback<TerritoryId> OnTerritoryClick { get; set; }

    /// <summary>Raised with the right-clicked territory's id (native context menu suppressed); only meaningful during Reinforce staging.</summary>
    [Parameter]
    public EventCallback<TerritoryId> OnTerritoryRightClick { get; set; }

    /// <summary>Staged-but-not-yet-dispatched troop counts per territory (Reinforce only); null/empty elsewhere.</summary>
    [Parameter]
    public IReadOnlyDictionary<TerritoryId, int>? Pending { get; set; }
}
