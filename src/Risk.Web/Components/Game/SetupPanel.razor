@using Risk.Domain.Errors
@using Risk.Web.Components.Shared

<div class="setup-panel panel-frame">
    <p class="setup-panel-hint">Hacé click en un territorio propio para colocar una tropa.</p>

    <RejectionMessage Error="Error" />
</div>

@code {
    /// <summary>
    /// The most recent rejection from a Setup-phase board click, if any —
    /// dispatch happens directly from the host page's click handler (a
    /// single click places 1 troop, no select-then-confirm step), so this
    /// panel is display-only.
    /// </summary>
    [Parameter]
    public GameError? Error { get; set; }
}
