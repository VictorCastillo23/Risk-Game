@using Risk.Domain.Cards
@using Risk.Domain.Errors
@using Risk.Domain.Map
@using Risk.Domain.Players
@using Risk.Engine.Commands
@using Risk.Engine.Events
@using Risk.Engine.Results
@using Risk.Engine.Rules
@using Risk.Engine.State
@using Risk.Web.Components.Shared
@using Risk.Web.Models
@using Risk.Web.Services
@inject GameSessionService Session

<div class="card-panel panel-frame">
    @{
        // Design's read convention (D5): the ONE place hidden information
        // matters — OwnHand comes from Observe(), never from raw
        // GameState.Players[x].Hand, so this panel structurally cannot
        // leak another player's cards. Hoisted (roadmap 5.4) so the Capital
        // HQ tray/warning section below can reuse the same PlayerView.
        var view = Session.ObserveCurrentPlayer();
        var hand = view.OwnHand;
    }

    @if (hand.Count >= MandatoryTradeThreshold)
    {
        <p class="card-panel-warning" role="alert">Tenés @hand.Count cartas: debés canjear un conjunto válido.</p>
    }

    @if (Session.State?.Mode == GameMode.Capital && HeadquartersTray.IsRevealed(view))
    {
        <div class="card-panel-hq">
            @if (HeadquartersTray.HasLostOwnHeadquarters(view, CurrentPlayer))
            {
                <p class="card-panel-warning" role="alert">Perdiste tu Cuartel General. Podés seguir jugando y recapturarlo.</p>
            }

            <ul class="card-panel-hq-tray">
                @foreach (var row in HeadquartersTray.Rows(view))
                {
                    <li>@Session.ConfigFor(row.Declarer).Name: @row.Territory.Value — en manos de @(row.Holder is { } holder ? Session.ConfigFor(holder).Name : "nadie")</li>
                }
            </ul>
        </div>
    }

    @if (hand.Count == 0)
    {
        <p class="card-panel-hint">No tenés cartas.</p>
    }
    else
    {
        <ul class="card-panel-hand">
            @for (var i = 0; i < hand.Count; i++)
            {
                var index = i;

                <li>
                    <label>
                        <input type="checkbox"
                               checked="@_selection.IsSelected(index)"
                               disabled="@(!_selection.IsSelected(index) && _selection.SelectedIndices.Count >= 3)"
                               @onchange="() => OnToggle(index)" />
                        @Describe(hand[index])
                    </label>
                </li>
            }
        </ul>

        var bonusMatches = ComputeBonusMatches(hand);

        @if (bonusMatches.Count >= 2)
        {
            <label class="card-panel-bonus-picker">
                Tenés más de un territorio elegible: elegí cuál recibe la bonificación.
                <select value="@(_bonusTerritory?.Value ?? "")" @onchange="OnBonusTerritoryChanged">
                    <option value="">Elegí un territorio</option>
                    @foreach (var territory in bonusMatches)
                    {
                        <option value="@territory.Value">@territory.Value</option>
                    }
                </select>
            </label>
        }

        <button type="button" disabled="@(!CanTrade(hand, bonusMatches))" @onclick="() => OnTradeClicked(hand, bonusMatches)">Canjear</button>
    }

    <RejectionMessage Error="_error" />
</div>

@code {
    private const int MandatoryTradeThreshold = 5;

    /// <summary>Always the acting player for this panel's command (design's dispatch contract: <c>Actor = Turn.CurrentPlayer</c>).</summary>
    [Parameter, EditorRequired]
    public PlayerId CurrentPlayer { get; set; }

    /// <summary>
    /// True while a conquest is pending occupation — the design's
    /// PendingOccupation flow disables the Card action alongside
    /// Attack/Fortify/EndPhase ("BoardSvg pointer-events:none ·
    /// Attack/Fortify/EndPhase/Card buttons disabled").
    /// </summary>
    [Parameter]
    public bool Locked { get; set; }

    private CardSelection _selection = CardSelection.Empty;
    private TerritoryId? _bonusTerritory;
    private GameError? _error;

    private void OnToggle(int index)
    {
        _selection = _selection.Toggle(index);

        // The selection changed, so any previously chosen bonus territory
        // may no longer be one of the (new) matches — force a fresh choice
        // rather than silently carrying a stale one into the next dispatch.
        _bonusTerritory = null;
    }

    /// <summary>
    /// The current 3-card selection's owned-territory matches, reusing the
    /// engine's own <see cref="TerritoryTradeBonus.ResolveMatches"/> rule
    /// (design's single-source-of-truth convention) rather than
    /// reimplementing it client-side. Empty unless the selection is a full,
    /// valid trade-in set.
    /// </summary>
    private IReadOnlyList<TerritoryId> ComputeBonusMatches(IReadOnlyList<Card> hand)
    {
        if (!_selection.IsValidTrade(hand) || Session.State is null)
        {
            return Array.Empty<TerritoryId>();
        }

        var cards = _selection.SelectedIndices.Select(i => hand[i]).ToArray();
        return TerritoryTradeBonus.ResolveMatches(cards, Session.State.Territories, CurrentPlayer);
    }

    private bool CanTrade(IReadOnlyList<Card> hand, IReadOnlyList<TerritoryId> bonusMatches) =>
        !Locked
        && _selection.IsValidTrade(hand)
        && (bonusMatches.Count < 2 || (_bonusTerritory.HasValue && bonusMatches.Contains(_bonusTerritory.Value)));

    private void OnBonusTerritoryChanged(ChangeEventArgs e)
    {
        var value = (string?)e.Value;
        _bonusTerritory = string.IsNullOrEmpty(value) ? null : new TerritoryId(value);
    }

    private void OnTradeClicked(IReadOnlyList<Card> hand, IReadOnlyList<TerritoryId> bonusMatches)
    {
        var cards = _selection.SelectedIndices.Select(i => hand[i]).ToArray();

        // 0 or 1 match: dispatch null, the engine auto-applies the single
        // match itself. 2+ matches: CanTrade already guarantees the picker
        // holds one of the matches before this can be clicked.
        var bonusTerritory = bonusMatches.Count >= 2 ? _bonusTerritory : null;

        var result = Session.Execute(new TradeCardsCommand(CurrentPlayer, cards, bonusTerritory));

        _error = result switch
        {
            CommandResult<GameState, GameEvent>.Ok => null,
            CommandResult<GameState, GameEvent>.Rejected rejected => rejected.Error,
            _ => _error
        };

        // Only clear the selection on success — the hand's indices shift
        // once the traded cards are removed. On rejection, keep the
        // selection so the player can see what they picked and retry.
        if (result is CommandResult<GameState, GameEvent>.Ok)
        {
            _selection = CardSelection.Empty;
            _bonusTerritory = null;
        }
    }

    private static string Describe(Card card) => card switch
    {
        TerritoryCard territoryCard => $"{territoryCard.Territory.Value} — {SymbolLabel(territoryCard.Symbol)}",
        WildCard => "Comodín",
        _ => "Carta"
    };

    private static string SymbolLabel(CardSymbol symbol) => symbol switch
    {
        CardSymbol.Infantry => "Infantería",
        CardSymbol.Cavalry => "Caballería",
        CardSymbol.Artillery => "Artillería",
        _ => symbol.ToString()
    };
}
