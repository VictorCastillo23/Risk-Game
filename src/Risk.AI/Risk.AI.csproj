<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Risk.Domain\Risk.Domain.csproj" />
    <ProjectReference Include="..\Risk.Engine\Risk.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
