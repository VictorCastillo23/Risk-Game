<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Risk.Domain\Risk.Domain.csproj" />
    <ProjectReference Include="..\Risk.Engine\Risk.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Risk.AI.Tests" />
    <!-- Risk.Web drives BotTurnRunner server-side (hot-seat AI seats use
         BotWeights.MaxCommandsPerGame as the drain budget; networked AI
         seats use RunTurn's MaxCommandsPerTurn default) — both constants
         live on the internal BotWeights and bake in at the call site, so
         this grant avoids a second Risk.Web-only tuning knob either way. -->
    <InternalsVisibleTo Include="Risk.Web" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
